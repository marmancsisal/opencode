{
  "server": { "host": "127.0.0.1", "port": 8787 },

  "provider": {
    "type": "azure-foundry",
    "endpoint": "https://NOME-RISORSA.openai.azure.com",
    "auth": "key",
    "apiKeyEnv": "AZURE_FOUNDRY_API_KEY",
    "timeoutMs": 120000
  },

  "oauth": {
    "scopes": "read:user",
    "defaultGroups": ["standard"]
  },

  "models": [
    { "id": "gpt-4.1-mini", "name": "GPT-4.1 mini", "deployment": "gpt-41-mini" },
    { "id": "gpt-4.1", "name": "GPT-4.1", "deployment": "gpt-41" },
    { "id": "DeepSeek-R1", "name": "DeepSeek R1", "deployment": "DeepSeek-R1" }
  ],
  "defaultModel": "gpt-4.1-mini",

  "users": [
    { "id": "alice", "apiKey": "byok_alice_demo_key", "groups": ["standard"] },
    { "id": "bob", "apiKey": "byok_bob_demo_key", "groups": ["junior"] }
  ],

  "rules": [
    {
      "id": "default-per-user",
      "match": {},
      "countBy": "user",
      "limits": { "rpm": 20, "rpd": 1000, "tokensPerDay": 2000000 }
    },
    {
      "id": "junior-stretto",
      "match": { "groups": ["junior"] },
      "countBy": "user",
      "limits": { "rpm": 5, "rpd": 200 }
    },
    {
      "id": "junior-niente-gpt41",
      "match": { "groups": ["junior"], "models": ["gpt-4.1"] },
      "access": "deny"
    },
    {
      "id": "modello-costoso-condiviso",
      "match": { "models": ["gpt-4.1"] },
      "countBy": "model",
      "limits": { "rph": 100 }
    },
    {
      "id": "alice-solo-mini",
      "match": { "users": ["alice"], "models": ["gpt-4.1-mini"] },
      "access": "allow"
    }
  ]
}
