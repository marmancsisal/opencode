# Copia in .env e compila. Non committare .env.

# Accesso alla dashboard /admin (stringa lunga e casuale, es. `openssl rand -hex 32`).
ADMIN_TOKEN=

# OAuth App GitHub dell'organizzazione con "Device Flow" abilitato (solo per identificare gli utenti).
GITHUB_OAUTH_CLIENT_ID=

# Azure AI Foundry: endpoint della risorsa (con o senza /openai/v1).
AZURE_FOUNDRY_ENDPOINT=https://NOME-RISORSA.openai.azure.com

# Autenticazione verso Azure: key | entra | managed-identity
AZURE_AUTH=key

# AZURE_AUTH=key
AZURE_FOUNDRY_API_KEY=

# AZURE_AUTH=entra (service principal con ruolo "Cognitive Services OpenAI User" sulla risorsa)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# AZURE_AUTH=managed-identity: su Azure Container Apps / App Service le variabili
# IDENTITY_ENDPOINT e IDENTITY_HEADER sono già presenti. Per un'identità
# user-assigned indica il suo client id:
# AZURE_CLIENT_ID=

# Retention (giorni)
# EVENTS_RETENTION_DAYS=90
# ROLLUP_RETENTION_DAYS=400
